(footprint "USBC_Breakout_8Pin_20x14mm"
	(version 20240108)
	(generator "kicad-footprint-generator")
	(layer "F.Cu")
	(descr "USB-C Breakout Board: 20x14mm PCB, 1x08 pins at 2.54mm pitch (2.2mm from bottom edge), USB-C connector centered at top edge, proud 0.5mm. Pinout: CC2, SBU1, D+, D-, CC1, SBU2, VBUS, GND")
	(tags "USB-C breakout 20x14mm 8pin 2.54mm")
	(property "Reference" "REF**"
		(at 8.89 -13.8 0)
		(layer "F.SilkS")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(property "Value" "USBC_Breakout"
		(at 8.89 3.8 0)
		(layer "F.Fab")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(attr through_hole)

	# --- Module PCB Outline (20mm x 14mm: X from -1.11 to 18.89, Y from -11.8 to 2.2) ---
	(fp_line (start -1.11 -11.8) (end 18.89 -11.8) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 18.89 -11.8) (end 18.89 2.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 18.89 2.2) (end -1.11 2.2) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start -1.11 2.2) (end -1.11 -11.8) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))

	# Fab outline
	(fp_line (start -1.11 -11.8) (end 18.89 -11.8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 18.89 -11.8) (end 18.89 2.2) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start 18.89 2.2) (end -1.11 2.2) (stroke (width 0.1) (type solid)) (layer "F.Fab"))
	(fp_line (start -1.11 2.2) (end -1.11 -11.8) (stroke (width 0.1) (type solid)) (layer "F.Fab"))

	# --- USB-C Connector (9mm x 7.3mm, centered at X=8.89, proud 0.5mm past top edge: Y -12.3 to -5.0) ---
	(fp_line (start 4.39 -12.3) (end 13.39 -12.3) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))
	(fp_line (start 13.39 -12.3) (end 13.39 -5.0) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))
	(fp_line (start 13.39 -5.0) (end 4.39 -5.0) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))
	(fp_line (start 4.39 -5.0) (end 4.39 -12.3) (stroke (width 0.2) (type solid)) (layer "F.SilkS"))

	# USB-C socket opening indicator
	(fp_line (start 5.5 -12.3) (end 5.5 -11.3) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 5.5 -11.3) (end 12.28 -11.3) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))
	(fp_line (start 12.28 -11.3) (end 12.28 -12.3) (stroke (width 0.15) (type solid)) (layer "F.SilkS"))

	(fp_text user "USB-C" (at 8.89 -8.3 0) (layer "F.SilkS")
		(effects (font (size 1.0 1.0) (thickness 0.15)))
	)

	# --- Pin 1 Chamfer & Dot Indicator ---
	(fp_circle (center -1.8 0) (end -1.6 0) (stroke (width 0.3) (type solid)) (layer "F.SilkS"))

	# --- Pin Silkscreen Labels: CC2, SBU1, D+, D-, CC1, SBU2, VBUS, GND ---
	(fp_text user "CC2" (at 0 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "SBU1" (at 2.54 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "D+" (at 5.08 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "D-" (at 7.62 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "CC1" (at 10.16 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "SBU2" (at 12.7 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "VBUS" (at 15.24 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))
	(fp_text user "GND" (at 17.78 -2.0 90) (layer "F.Fab") (effects (font (size 0.8 0.8) (thickness 0.12)) (justify left)))

	# --- Courtyard ---
	(fp_line (start -1.4 -12.6) (end 19.2 -12.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 19.2 -12.6) (end 19.2 2.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start 19.2 2.5) (end -1.4 2.5) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))
	(fp_line (start -1.4 2.5) (end -1.4 -12.6) (stroke (width 0.05) (type solid)) (layer "F.CrtYd"))

	# --- Through Hole Pads (1x08, pitch 2.54mm, 2.2mm from bottom edge) ---
	(pad "1" thru_hole rect
		(at 0 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "2" thru_hole circle
		(at 2.54 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "3" thru_hole circle
		(at 5.08 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "4" thru_hole circle
		(at 7.62 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "5" thru_hole circle
		(at 10.16 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "6" thru_hole circle
		(at 12.7 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "7" thru_hole circle
		(at 15.24 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
	(pad "8" thru_hole circle
		(at 17.78 0)
		(size 1.7 1.7)
		(drill 1.0)
		(layers "*.Cu" "*.Mask")
	)
)
